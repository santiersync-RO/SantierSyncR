# URL-ul canonic folosit pentru linkuri, metadate și sitemap.
SITE_URL=https://santiersync.ro
# Numai Production pe domeniul canonic; Preview/dev rămân întotdeauna noindex.
PUBLIC_INDEXING_ENABLED=false
# Sanity: valorile reale sunt configurate local și în Vercel, fără secrete în Git.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_WEBHOOK_SECRET=
# URL-ul panoului autorizat pentru iframe: *.sanity.studio sau URL oficial Sanity /@organizație/studio/id.
SANITY_STUDIO_URL=
# live este implicit și păstrează gate-ul strict existent. Pentru experimentul personal
# Vercel Hobby, setați demo numai în mediul de hosting al acelui demo.
DEPLOYMENT_STAGE=live
# Necesită confirmarea controlului domeniului și configurarea DNS/HTTPS.
DOMAIN_CONFIRMED=false

# GA4 direct gtag.js: public measurement ID. Invalid explicit values disable analytics.
GA_MEASUREMENT_ID=G-LGQ4TNEBZV
# false by default. Set true temporarily only for intentional CMP/GA consent-flow checks.
GA_ALLOW_LOCAL_TESTING=false

# Publicare și informări juridice. Toate trebuie confirmate înainte de lansare.
RELEASE_APPROVED=false
MAILBOX_TESTED=false
# true numai după verificarea fallback-ului public de email și o probă manuală primită în inbox.
# Succesul API-ului Resend nu înlocuiește această confirmare.
LEGAL_REVIEWED=false
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_TYPE=
LEGAL_OPERATOR_ADDRESS=
LEGAL_REGISTRATION_NUMBER=
LEGAL_TAX_ID=
LEGAL_LAST_UPDATED=
LEGAL_CONTACT_EMAIL=
LEGAL_REQUEST_BASIS=
LEGAL_SECURITY_BASIS=
LEGAL_RETENTION_POLICY=
LEGAL_PROCESSORS_POLICY=
LEGAL_STORAGE_POLICY=

# Formular POST direct la API-ul aplicației și livrare prin Resend.
# Păstrează ambele flaguri false în Production până când credențialele Resend/Turnstile
# și domeniul expeditor sunt configurate și verificate; UI/API rămân oprite până atunci.
CONTACT_ENABLED=false
NEXT_PUBLIC_CONTACT_ENABLED=false
CONTACT_ALLOWED_ORIGINS=https://santiersync.ro
TURNSTILE_ALLOWED_HOSTNAMES=santiersync.ro
CONTACT_TO_EMAIL=santiersync@gmail.com
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Opțional: evidență pentru o regulă suplimentară WAF; aplicația nu o cere pentru activarea API-ului.
WAF_RATE_LIMIT_CONFIGURED=false
# true numai după ce domeniul expeditor este verificat în Resend.
SENDER_DOMAIN_VERIFIED=false
# Opțional: fila privată pentru mesaje în registrul existent. Necesită redeploy Apps Script.
CONTACT_REGISTRY_ENABLED=false
CONTACT_REGISTRY_VERIFIED=false

# Cal.com Free: activează după configurarea reală a evenimentului și a registrului.
BOOKING_ENABLED=false
CALCOM_EVENT_URL=https://cal.com/santiersyncro/30min
CALCOM_EVENT_TYPE_ID=
CALCOM_ORGANIZER_USERNAME=santiersyncro
# true numai după salvarea celor două întrebări REQUIRED în evenimentul Cal.com.
CALCOM_REQUIRED_QUESTIONS_CONFIRMED=false
# Webhookul poate fi activat pentru proba tehnică înaintea butonului public.
CALCOM_WEBHOOK_ENABLED=false
CALCOM_WEBHOOK_SECRET=
# URL-ul /exec al aplicației Google Apps Script; registrul Sheet rămâne privat.
REGISTRY_ENDPOINT_URL=
REGISTRY_SHARED_SECRET=
